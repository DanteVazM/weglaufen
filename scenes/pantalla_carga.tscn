[sub_resource type="GDScript" id="GDScript_carga1"]
script/source = "extends Control
## Pantalla de carga: muestra una imagen y carga la escena siguiente.
## La imagen se asigna en el nodo \"Imagen\" (propiedad Texture).

var next_scene: String = \"res://scenes/mundos/ciudad.tscn\"   # escena que se carga despues
@export var min_seconds: float = 0.0                 # tiempo minimo mostrando la imagen

var _elapsed := 0.0
var _loading := false

func _ready() -> void:
	if next_scene == \"\":
		push_error(\"Asigna 'Next Scene' en el Inspector del nodo raiz.\")
		return

	# Esperar 2 frames para que la imagen se dibuje ANTES de empezar a cargar
	await get_tree().process_frame
	await get_tree().process_frame

	var err := ResourceLoader.load_threaded_request(next_scene)
	if err != OK:
		push_error(\"No pude cargar %s (error %d)\" % [next_scene, err])
		return
	_loading = true

func _process(delta: float) -> void:
	if not _loading:
		return
	_elapsed += delta

	var status := ResourceLoader.load_threaded_get_status(next_scene)
	match status:
		ResourceLoader.THREAD_LOAD_LOADED:
			if _elapsed >= min_seconds:
				_loading = false
				var packed := ResourceLoader.load_threaded_get(next_scene) as PackedScene
				get_tree().change_scene_to_packed(packed)
		ResourceLoader.THREAD_LOAD_FAILED, ResourceLoader.THREAD_LOAD_INVALID_RESOURCE:
			_loading = false
			push_error(\"Fallo la carga de \" + next_scene)
"

